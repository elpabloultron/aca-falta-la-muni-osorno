# Plantilla de variables de entorno para desarrollo local
# Duplica este archivo como .env.local y completa tus credenciales públicas de Firebase
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aca-falta-la-muni-osorno
NEXT_PUBLIC_FIREBASE_APP_ID=tu-app-id-de-firebase
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aca-falta-la-muni-osorno.firebasestorage.app
NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key-de-firebase
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aca-falta-la-muni-osorno.firebaseapp.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu-messaging-sender-id
