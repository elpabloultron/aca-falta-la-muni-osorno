rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: reports
    // Document ID: custom report ID (e.g. rep_xxx)
    // Fields:
    //   - id: string (required) - Identificador único de la denuncia
    //   - title: string (required, 3-100 chars) - Título del problema
    //   - description: string (required, 5-1500 chars) - Detalle y consecuencias
    //   - category: string (required) - Categoría comunal válida
    //   - sector: string (required) - Barrio o sector de Osorno
    //   - is_rural: bool (optional) - Indica si pertenece a sector rural
    //   - address_reference: string (required) - Dirección o punto referencial
    //   - latitude: number (required) - Coordenada latitud en Osorno
    //   - longitude: number (required) - Coordenada longitud en Osorno
    //   - image_url: string (optional) - Fotografía de evidencia
    //   - resolved_image_url: string (optional) - Evidencia de solución
    //   - author_name: string (required) - Nombre o 'Vecino de Osorno'
    //   - is_anonymous: bool (required) - Publicación anónima
    //   - status: string (required: 'pendiente', 'en_revision', 'resuelto')
    //   - support_count: number (required, >= 0) - Cantidad de apoyos vecinales
    //   - flags_count: number (optional, >= 0) - Contador de denuncias por moderación
    //   - is_hidden: bool (optional) - Oculto por moderación
    //   - created_at: string (required) - Fecha ISO 8601
    //   - updated_at: string (required) - Fecha ISO 8601
    //   - resolved_at: string (optional) - Fecha ISO 8601 de solución
    //
    // Collection: supports
    // Document ID: [reportId]_[deviceId]
    // Fields:
    //   - report_id: string (required)
    //   - device_id: string (required)
    //   - created_at: string (required)
    //
    // Collection: moderation_flags
    // Document ID: [reportId]_[deviceId] o auto-id
    // Fields:
    //   - report_id: string (required)
    //   - device_id: string (required)
    //   - reason: string (optional)
    //   - created_at: string (required)
    //
    // ===============================================================

    // Helper Functions
    function isValidCategory(cat) {
      return cat in ['calles', 'iluminacion', 'limpieza', 'aguas', 'espacios', 'accesibilidad', 'transito', 'animales', 'medio_ambiente', 'otros'];
    }

    function isValidStatus(st) {
      return st in ['pendiente', 'en_revision', 'resuelto'];
    }

    function isValidReportCreate(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'sector', 'latitude', 'longitude', 'status', 'support_count', 'created_at'])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 100
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1500
        && isValidCategory(data.category)
        && data.sector is string && data.sector.size() >= 2
        && data.latitude is number && data.latitude >= -42.0 && data.latitude <= -39.0
        && data.longitude is number && data.longitude >= -75.0 && data.longitude <= -71.0
        && data.status in ['pendiente', 'en_revision']
        && data.support_count is number && data.support_count >= 0;
    }

    function isValidReportUpdate(data) {
      return isValidCategory(data.category)
        && isValidStatus(data.status)
        && data.support_count is number && data.support_count >= 0;
    }

    function isValidCommentCreate(data) {
      return data.keys().hasAll(['report_id', 'comment', 'created_at', 'author_name', 'is_anonymous'])
        && data.report_id is string
        && data.comment is string
        && data.comment.size() >= 2
        && data.comment.size() <= 600
        && data.author_name is string
        && data.is_anonymous is bool
        && data.created_at is string;
    }

    match /reports/{reportId} {
      // Lectura pública para cualquier ciudadano o entidad fiscalizadora
      allow read: if true;
      
      // Creación ciudadana abierta con validación estricta de estructura y tipos
      allow create: if isValidReportCreate(request.resource.data);

      // Actualizaciones permitidas para sumar apoyos cívicos (+1), moderar o marcar como resuelto
      allow update: if isValidReportUpdate(request.resource.data);

      // No permitir borrado arbitrario para preservar la memoria cívica de la comuna
      allow delete: if false;
    }

    match /supports/{supportId} {
      allow read: if true;
      allow write: if request.resource.data.report_id is string && request.resource.data.device_id is string;
    }

    match /moderation_flags/{flagId} {
      allow read: if true;
      allow create: if request.resource.data.report_id is string && request.resource.data.device_id is string;
      allow update, delete: if false;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidCommentCreate(request.resource.data);
      allow update, delete: if false;
    }
  }
}
