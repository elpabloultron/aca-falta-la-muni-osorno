rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Reglas Blindadas de Seguridad Ciudadana - Acá Falta la Muni (Osorno)
    // Auditoría de Seguridad: Red Team / OWASP / Prevención de Abusos
    // ===============================================================

    function isValidCategory(cat) {
      return cat in ['calles', 'iluminacion', 'limpieza', 'aguas', 'espacios', 'accesibilidad', 'transito', 'animales', 'medio_ambiente', 'otros'];
    }

    function isValidStatus(st) {
      return st in ['pendiente', 'en_revision', 'resuelto'];
    }

    // 1. Validación estricta de creación de reportes
    function isValidReportCreate(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'sector', 'latitude', 'longitude', 'status', 'support_count', 'created_at'])
        // Título delimitado
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 100
        // Descripción acotada (previene saturación / buffer abuse)
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1500
        && isValidCategory(data.category)
        && data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 80
        // Coordenadas estrictamente confinadas a la provincia / comuna de Osorno
        && data.latitude is number && data.latitude >= -42.0 && data.latitude <= -39.0
        && data.longitude is number && data.longitude >= -75.0 && data.longitude <= -71.0
        && data.status in ['pendiente', 'en_revision']
        // Apoyos iniciales seguros
        && data.support_count is number && data.support_count >= 0 && data.support_count <= 5
        && data.created_at is string;
    }

    // 2. Validación estricta de actualización (Elimina el 'Update Bypass' y preserva inmutabilidad)
    function isValidReportUpdate(data, prev) {
      // Campos absolutamente inmutables una vez creada la denuncia
      let immutablePreserved = 
        data.title == prev.title
        && data.description == prev.description
        && data.category == prev.category
        && data.sector == prev.sector
        && data.latitude == prev.latitude
        && data.longitude == prev.longitude
        && data.created_at == prev.created_at
        && (prev.get('id', '') == '' || data.id == prev.id)
        && (prev.get('author_name', '') == '' || data.author_name == prev.author_name)
        && (prev.get('is_anonymous', false) == false || data.is_anonymous == prev.is_anonymous);

      // Mutaciones legítimas permitidas por la aplicación:
      // Caso A: Apoyo cívico (+1 o -1 sin saltos gigantescos)
      let isSupportMutation = 
        data.support_count is number
        && (data.support_count == prev.support_count + 1 || data.support_count == prev.support_count - 1 || data.support_count == prev.support_count)
        && data.status == prev.status;

      // Caso B: Moderación comunitaria (acumulación de marcas o censura preventiva con >= 3)
      let isModerationMutation = 
        data.flags_count is number
        && data.flags_count >= prev.get('flags_count', 0)
        && data.flags_count <= prev.get('flags_count', 0) + 1
        && (data.is_hidden is bool);

      // Caso C: Marcado de resolución (con evidencia opcional)
      let isResolutionMutation = 
        isValidStatus(data.status)
        && (data.status != 'resuelto' || data.resolved_at is string);


      return immutablePreserved && (isSupportMutation || isModerationMutation || isResolutionMutation);
    }

    // 3. Validación de comentarios comunitarios
    function isValidCommentCreate(data) {
      return data.keys().hasAll(['report_id', 'comment', 'created_at', 'author_name', 'is_anonymous'])
        && data.report_id is string && data.report_id.size() >= 3 && data.report_id.size() <= 80
        && data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 600
        && data.author_name is string && data.author_name.size() >= 2 && data.author_name.size() <= 80
        && data.is_anonymous is bool
        && data.created_at is string;
    }

    // Colección: Denuncias ciudadanas
    match /reports/{reportId} {
      // Lectura abierta para transparencia cívica comunal
      allow read: if true;
      
      // Creación con validación estricta de estructura y límites de longitud
      allow create: if isValidReportCreate(request.resource.data);

      // Actualización protegida: campos inmutables bloqueados y cambios de estado regulados
      allow update: if isValidReportUpdate(request.resource.data, resource.data);

      // Prohibido el borrado para preservar el registro histórico de inacción municipal
      allow delete: if false;
    }

    // Colección: Apoyos únicos por dispositivo (+1)
    match /supports/{supportId} {
      allow read: if true;
      allow create: if request.resource.data.report_id is string 
                    && request.resource.data.device_id is string
                    && request.resource.data.report_id.size() > 0
                    && request.resource.data.device_id.size() > 0
                    && request.resource.data.created_at is string;
      allow update, delete: if false;
    }

    // Colección: Denuncias de moderación
    match /moderation_flags/{flagId} {
      allow read: if true;
      allow create: if request.resource.data.report_id is string 
                    && request.resource.data.device_id is string
                    && request.resource.data.report_id.size() > 0
                    && request.resource.data.device_id.size() > 0
                    && request.resource.data.created_at is string;
      allow update, delete: if false;
    }

    // Colección: Muro de comentarios vecinales
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidCommentCreate(request.resource.data);
      allow update, delete: if false;
    }
  }
}
